}>) {
  return (
    <html lang="en">
      {/* Removed the layout constraints from the body tag and moved them to a dedicated wrapper below */}
      <body className="bg-[#020617] text-slate-100 antialiased">
        
        {/* STRICT WRAPPER: This locks the screen width to 100vw and hides horizontal overflow, killing the black gap */}
        <div className="relative flex flex-col min-h-screen w-full max-w-[100vw] overflow-x-hidden">
          
          {/* Abstract Background Glow (Fixed to shrink on mobile by using w-full max-w-[1000px]) */}
          <div className="absolute top-0 left-1/2 w-full max-w-[1000px] h-[500px] bg-blue-900/20 rounded-full blur-[120px] -translate-x-1/2 -z-10 pointer-events-none"></div>

